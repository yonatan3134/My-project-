[Unit]
Description=WhatsApp channels bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wabot
WorkingDirectory=__DIR__
ExecStart=__NODE__ dist/index.js
Restart=always
RestartSec=10
# 78 = the WhatsApp account was logged out; restarting cannot fix that, a person has to link it again
RestartPreventExitStatus=78
Environment=NODE_ENV=production
MemoryMax=1500M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
